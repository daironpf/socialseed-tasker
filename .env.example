# Tasker CLI Configuration
# =======================
# Copy this to .env and fill in your values
# Or set environment variables directly
#
# Configuration is resolved in this order:
#   1. Environment variables (e.g., TASKER_MODE, TASKER_API_URL)
#   2. .agent/configs/tasker.yml file
#   3. Built-in defaults

# ========== OPERATION MODE ==========
# Choose "direct" (Neo4j Bolt) or "api" (REST API)
# Default: direct
TASKER_MODE=direct

# ========== DIRECT MODE (Neo4j Bolt) ==========
# Used only when TASKER_MODE=direct
# Requires Neo4j to be running at this address

# Neo4j connection string
# Format: bolt://host:port or bolt+s://host:port (for SSL/TLS)
# Default: bolt://localhost:7687
TASKER_NEO4J_URI=bolt://localhost:7687

# Neo4j username
# Default: neo4j
TASKER_NEO4J_USER=neo4j

# Neo4j password
# Required for Direct mode to work
# Default: (none - must be set)
TASKER_NEO4J_PASSWORD=neoSocial

# ========== API MODE (REST API) ==========
# Used only when TASKER_MODE=api
# Requires FastAPI backend to be running

# FastAPI backend base URL
# Example: http://localhost:8888
# Example: https://tasker-api.example.com
# Default: http://localhost:8888
TASKER_API_URL=http://localhost:8888

# API authentication key (optional)
# Use Bearer token format: "sk-abc123..."
# Only required if API server enforces authentication
# Default: (none - authentication optional)
# TASKER_API_KEY=sk-your-api-key-here

# API request timeout in seconds
# Default: 10
TASKER_API_TIMEOUT=10

# ========== DOCKER COMPOSE (tasker setup) ==========
# Read by `docker compose` from this .env (project directory).
# `tasker setup` creates a minimal .env when none exists; these are the
# optional keys it leaves at their defaults.

# First-run flag consumed by the web Setup Wizard.
# Default: false
TASKER_INSTALLED=false

# Host port for the frontend board (Setup Wizard lives at /setup).
# Default: 19001
# FRONTEND_PORT=19001

# Host port for the FastAPI backend.
# Default: 8888
# API_PORT=8888

# Neo4j password injected into the container (NEO4J_AUTH) and healthcheck.
# Default: neoSocial
# TASKER_NEO4J_PASSWORD=neoSocial

# Host port for the PostgreSQL service.
# Default: 15432
# TASKER_PG_PORT=15432

# Host port for the mock API service.
# Default: 8001
# MOCK_API_PORT=8001

# Shared secrets for the API container.
# Defaults: test-token / tasker-local-review-secret / test-webhook-secret
# TASKER_API_KEY=test-token
# TASKER_JWT_SECRET=tasker-local-review-secret
# GITHUB_WEBHOOK_SECRET=test-webhook-secret

# ========== OPTIONAL: LOGGING ==========
# Log level: DEBUG, INFO, WARNING, ERROR
# Default: INFO
# TASKER_LOG_LEVEL=INFO

# ========== SETUP EXAMPLES ==========
# 
# Direct Mode (Local Development):
#   TASKER_MODE=direct
#   TASKER_NEO4J_URI=bolt://localhost:7687
#   TASKER_NEO4J_USER=neo4j
#   TASKER_NEO4J_PASSWORD=neoSocial
#
# API Mode (Local Testing):
#   TASKER_MODE=api
#   TASKER_API_URL=http://localhost:8888
#
# API Mode (Production):
#   TASKER_MODE=api
#   TASKER_API_URL=https://tasker-api.example.com
#   TASKER_API_KEY=sk-prod-abc123def456...
#   TASKER_API_TIMEOUT=30
#
# Direct Mode (Remote Neo4j):
#   TASKER_MODE=direct
#   TASKER_NEO4J_URI=bolt+s://prod-db.example.com:7687
#   TASKER_NEO4J_USER=tasker-user
#   TASKER_NEO4J_PASSWORD=$NEO4J_PASSWORD
