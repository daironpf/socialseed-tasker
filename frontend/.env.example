# API data source (issue #517)
# - "true"  (default): mock dataset served through the mock API client
# - "false": use the real FastAPI backend at VITE_API_URL (/api/v1)
# Can also be switched at runtime from the user menu (Data Source).
VITE_USE_MOCK=true

# API base URL used by the real client and the SSE streams.
# Proxied by Vite dev server (/api -> http://localhost:8000) and by nginx
# in Docker (/api -> http://tasker-api:8000/api/).
VITE_API_URL=/api/v1

# SSE endpoints (available when VITE_USE_MOCK=false):
#   GET  /api/v1/issues/{id}/agent-logs/stream   — agent log stream (replay + live)
#   POST /api/v1/issues/{id}/agent-logs          — publish a log entry
#   GET  /api/v1/issues/{id}/presence/stream     — issue viewers stream
#   POST /api/v1/issues/{id}/presence            — join / heartbeat
#   POST /api/v1/issues/{id}/presence/leave      — leave
