"""Relationship Repository Template.

Use this for nodes that primarily manage relationships between other nodes.
Example: Policy links, Agent specializations, Project-Agent assignments, etc.

Usage:
    1. Copy to new file (e.g., project_agent_repository.py)
    2. Customize the relationship types and labels
    3. Add specific methods for your use case

Example:
    # For Project-Agent assignment:
    # (Project)-[:ASSIGNED_TO]->(Agent)
    
    repo = RelationshipRepository(driver)
    repo.create_relationship("Project", "proj-1", "Agent", "agent-1", "ASSIGNED_TO")
    agents = repo.get_related("Project", "proj-1", "ASSIGNED_TO", "Agent")
"""

from __future__ import annotations

from typing import Any


class RelationshipRepository:
    """Template for relationship-focused repositories.
    
    Provides generic methods for creating, deleting, and querying relationships
    between nodes in Neo4j.
    
    Example:
        repo = RelationshipRepository(driver)
        
        # Create relationship
        repo.create_relationship(
            source_label="Project",
            source_id="proj-123",
            target_label="Agent",
            target_id="agent-456",
            relationship_type="ASSIGNED_TO"
        )
        
        # Get all agents assigned to a project
        agents = repo.get_related(
            source_label="Project",
            source_id="proj-123",
            relationship_type="ASSIGNED_TO",
            target_label="Agent"
        )
        
        # Delete relationship
        repo.delete_relationship(
            source_label="Project",
            source_id="proj-123",
            target_label="Agent",
            target_id="agent-456",
            relationship_type="ASSIGNED_TO"
        )
    """

    def __init__(self, driver: Any) -> None:
        """Initialize repository with Neo4j driver.
        
        Args:
            driver: Neo4j driver (wrapper or direct driver)
        """
        self._driver = driver

    def _get_session(self):
        """Get Neo4j session, handling both wrapper and direct drivers."""
        if hasattr(self._driver, "driver"):
            return self._driver.driver.session(database=self._driver.database)
        return self._driver.session(database="neo4j")

    def create_relationship(
        self,
        source_label: str,
        source_id: str,
        target_label: str,
        target_id: str,
        relationship_type: str,
        properties: dict | None = None,
    ) -> None:
        """Create a relationship between two nodes.
        
        Uses MERGE for idempotent creation - safe to call multiple times.
        
        Args:
            source_label: Label of the source node (e.g., "Project", "Agent")
            source_id: ID of the source node
            target_label: Label of the target node
            target_id: ID of the target node
            relationship_type: Type of relationship (e.g., "ASSIGNED_TO", "SPECIALIST_IN")
            properties: Optional dictionary of relationship properties
        """
        with self._get_session() as session:
            props_str = ""
            params = {"source_id": source_id, "target_id": target_id}
            
            if properties:
                props_str = ", " + ", ".join([f"r.{k} = ${k}" for k in properties.keys()])
                params.update(properties)
            
            query = f"""
            MATCH (s:{source_label} {{id: $source_id}})
            MATCH (t:{target_label} {{id: $target_id}})
            MERGE (s)-[r:{relationship_type}{props_str}]->(t)
            """
            session.run(query, params)

    def delete_relationship(
        self,
        source_label: str,
        source_id: str,
        target_label: str,
        target_id: str,
        relationship_type: str,
    ) -> None:
        """Delete a specific relationship between two nodes.
        
        Args:
            source_label: Label of the source node
            source_id: ID of the source node
            target_label: Label of the target node
            target_id: ID of the target node
            relationship_type: Type of relationship to delete
        """
        with self._get_session() as session:
            session.run(
                f"""
                MATCH (s:{source_label} {{id: $source_id}})-[r:{relationship_type}]->(t:{target_label} {{id: $target_id}})
                DELETE r
                """,
                {"source_id": source_id, "target_id": target_id},
            )

    def get_related(
        self,
        source_label: str,
        source_id: str,
        relationship_type: str,
        target_label: str | None = None,
    ) -> list[dict]:
        """Get all nodes related to a source via a relationship.
        
        Args:
            source_label: Label of the source node
            source_id: ID of the source node
            relationship_type: Type of relationship to follow
            target_label: Optional filter for target node label
            
        Returns:
            List of target nodes as dictionaries
        """
        with self._get_session() as session:
            target = f":{target_label}" if target_label else ""
            result = session.run(
                f"""
                MATCH (s:{source_label} {{id: $source_id}})-[r:{relationship_type}]->(t{target})
                RETURN t
                """,
                {"source_id": source_id},
            )
            return [dict(r["t"]) for r in result]

    def get_incoming(
        self,
        target_label: str,
        target_id: str,
        relationship_type: str,
        source_label: str | None = None,
    ) -> list[dict]:
        """Get all nodes that have a relationship TO this node.
        
        Args:
            target_label: Label of the target node
            target_id: ID of the target node
            relationship_type: Type of relationship (incoming)
            source_label: Optional filter for source node label
            
        Returns:
            List of source nodes as dictionaries
        """
        with self._get_session() as session:
            source = f":{source_label}" if source_label else ""
            result = session.run(
                f"""
                MATCH (s{source})-[r:{relationship_type}]->(t:{target_label} {{id: $target_id}})
                RETURN s
                """,
                {"target_id": target_id},
            )
            return [dict(r["s"]) for r in result]

    def relationship_exists(
        self,
        source_label: str,
        source_id: str,
        target_label: str,
        target_id: str,
        relationship_type: str,
    ) -> bool:
        """Check if a specific relationship exists.
        
        Args:
            source_label: Label of the source node
            source_id: ID of the source node
            target_label: Label of the target node
            target_id: ID of the target node
            relationship_type: Type of relationship
            
        Returns:
            True if relationship exists, False otherwise
        """
        with self._get_session() as session:
            result = session.run(
                f"""
                MATCH (s:{source_label} {{id: $source_id}})-[r:{relationship_type}]->(t:{target_label} {{id: $target_id}})
                RETURN count(r) > 0 as exists
                """,
                {"source_id": source_id, "target_id": target_id},
            )
            return result.single()["exists"]

    def count_relationships(
        self,
        source_label: str,
        source_id: str,
        relationship_type: str,
    ) -> int:
        """Count outgoing relationships from a node.
        
        Args:
            source_label: Label of the source node
            source_id: ID of the source node
            relationship_type: Type of relationship to count
            
        Returns:
            Number of relationships
        """
        with self._get_session() as session:
            result = session.run(
                f"""
                MATCH (s:{source_label} {{id: $source_id}})-[r:{relationship_type}]->(t)
                RETURN count(r) as count
                """,
                {"source_id": source_id},
            )
            return result.single()["count"]


