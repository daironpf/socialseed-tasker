"""{{ entity_name }} Repository - Neo4j storage for {{ entity_description }}.

This template provides basic CRUD operations. Copy to new file and customize.

Usage:
    1. Copy this file to ../{{ entity_name_snake }}_repository.py
    2. Update imports to use your entity from core/
    3. Customize the entity fields and queries
    4. Add the queries to queries.py
    5. Register in wiring.py if needed

Example:
    cp simple_crud_repository.py.template ../my_entity_repository.py
"""

from __future__ import annotations

from datetime import datetime, timezone
from typing import Any


def _now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


