class {{ EntityName }}Repository:
    """Repository for {{ entity_description }} in Neo4j.
    
    Copy this class to a new file (e.g., user_repository.py) and customize.
    
    Example usage:
        from socialseed_tasker.bootstrap.wiring import get_driver
        from socialseed_tasker.storage.graph_database.my_entity_repository import {{ EntityName }}Repository
        
        driver = get_driver()
        repo = {{ EntityName }}Repository(driver)
        
        # Create
        repo.create(my_entity)
        
        # Get
        entity = repo.get("entity-id")
        
        # List
        entities = repo.list(limit=10)
        
        # Update
        updated = repo.update("entity-id", {"name": "New Name"})
        
        # Delete
        repo.delete("entity-id")
    """

    def __init__(self, driver: Any) -> None:
        """Initialize repository with Neo4j driver.
        
        Args:
            driver: Neo4j driver (wrapper or direct driver)
        """
        self._driver = driver

    def _get_session(self):
        """Get Neo4j session, handling both wrapper and direct drivers."""
        if hasattr(self._driver, "driver"):
            return self._driver.driver.session(database=self._driver.database)
        return self._driver.session(database="neo4j")

    def create(self, entity: Any) -> None:
        """Create a new {{ entity_name }} in Neo4j.
        
        Args:
            entity: Domain entity to create
        """
        with self._get_session() as session:
            session.run(
                # queries.CREATE_{{ ENTITY_NAME_UPPER }},
                {
                    "id": str(entity.id),
                    "name": entity.name,
                    "description": getattr(entity, "description", ""),
                    "created_at": entity.created_at.isoformat() if hasattr(entity, "created_at") else _now_iso(),
                    "updated_at": entity.updated_at.isoformat() if hasattr(entity, "updated_at") else _now_iso(),
                }
            )

    def get(self, entity_id: str) -> Any | None:
        """Get a {{ entity_name }} by ID.
        
        Args:
            entity_id: UUID or string ID of the entity
            
        Returns:
            Entity if found, None otherwise
        """
        with self._get_session() as session:
            result = session.run(
                # queries.GET_{{ ENTITY_NAME_UPPER }},
                {"id": entity_id}
            )
            record = result.single()
            if record is None:
                return None
            # return _node_to_entity(record["n"])
            return dict(record["n"])

    def list(self, limit: int = 50, offset: int = 0) -> list[Any]:
        """List all {{ entity_name }}s with pagination.
        
        Args:
            limit: Maximum number of results
            offset: Number of results to skip
            
        Returns:
            List of entities
        """
        with self._get_session() as session:
            result = session.run(
                # queries.LIST_{{ ENTITY_NAME_UPPER }}S,
                {"limit": limit, "offset": offset}
            )
            # return [_node_to_entity(r["n"]) for r in result]
            return [dict(r["n"]) for r in result]

    def update(self, entity_id: str, updates: dict[str, Any]) -> Any:
        """Update a {{ entity_name }}.
        
        Args:
            entity_id: ID of the entity to update
            updates: Dictionary of properties to update
            
        Returns:
            Updated entity
            
        Raises:
            ValueError: If entity not found
        """
        with self._get_session() as session:
            result = session.run(
                # queries.UPDATE_{{ ENTITY_NAME_UPPER }},
                {
                    "id": entity_id,
                    "updates": updates,
                    "updated_at": _now_iso(),
                }
            )
            record = result.single()
            if record is None:
                raise ValueError(f"{{ entity_name }} {entity_id} not found")
            # return _node_to_entity(record["n"])
            return dict(record["n"])

    def delete(self, entity_id: str) -> None:
        """Delete a {{ entity_name }}.
        
        Args:
            entity_id: ID of the entity to delete
        """
        with self._get_session() as session:
            session.run(
                # queries.DELETE_{{ ENTITY_NAME_UPPER }},
                {"id": entity_id}
            )

    # -------------------------------------------------------------------------
    # Additional methods - Customize for your entity
    # -------------------------------------------------------------------------

    def find_by_name(self, name: str) -> Any | None:
        """Find {{ entity_name }} by exact name.
        
        Args:
            name: Exact name to search for
            
        Returns:
            Entity if found, None otherwise
        """
        with self._get_session() as session:
            result = session.run(
                "MATCH (n:{{ EntityName }} {name: $name}) RETURN n",
                {"name": name}
            )
            record = result.single()
            if record is None:
                return None
            return dict(record["n"])

    def count(self) -> int:
        """Count total {{ entity_name }}s in database.
        
        Returns:
            Total count
        """
        with self._get_session() as session:
            result = session.run("MATCH (n:{{ EntityName }}) RETURN count(n) as count")
            return result.single()["count"]


