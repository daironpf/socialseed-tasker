"""Query Template for {{ entity_name }}.

Copy these queries to storage/graph_database/queries.py and customize.

Usage:
    1. Copy the relevant queries to queries.py
    2. Replace {{ placeholders }} with your entity name
    3. Add/remove properties as needed

Example:
    # For "Deployment" entity:
    # CREATE_DEPLOYMENT = """..."""
 becomes:
    CREATE_DEPLOYMENT = """..."""
"""

# =============================================================================
# Entity Queries - Basic CRUD
# =============================================================================

# -----------------------------------------------------------------------------
# CREATE - Insert a new node
# -----------------------------------------------------------------------------

CREATE_{{ ENTITY_NAME_UPPER }} = """
CREATE (n:{{ EntityName }} {
    id: $id,
    name: $name{% for prop in properties %},
    {{ prop.name }}: ${{ prop.name }}{% endfor %}
})
RETURN n
"""

# -----------------------------------------------------------------------------
# GET - Retrieve single node by ID
# -----------------------------------------------------------------------------

GET_{{ ENTITY_NAME_UPPER }} = """
MATCH (n:{{ EntityName }} {id: $id})
RETURN n
"""

# -----------------------------------------------------------------------------
# UPDATE - Update node properties
# -----------------------------------------------------------------------------

UPDATE_{{ ENTITY_NAME_UPPER }} = """
MATCH (n:{{ EntityName }} {id: $id})
SET n += $updates, n.updatedAt = $updated_at
RETURN n
"""

# -----------------------------------------------------------------------------
# DELETE - Delete node (with DETACH to remove relationships)
# -----------------------------------------------------------------------------

DELETE_{{ ENTITY_NAME_UPPER }} = """
MATCH (n:{{ EntityName }} {id: $id})
DETACH DELETE n
"""

# -----------------------------------------------------------------------------
# LIST - Paginated list with optional filters
# -----------------------------------------------------------------------------

LIST_{{ ENTITY_NAME_UPPER }}S = """
MATCH (n:{{ EntityName }}){% if filters %}
WHERE {% for f in filters %}n.{{ f }} = ${{ f }}{% if not loop.last %} AND {% endif %}{% endfor %}{% endif %}
RETURN n
ORDER BY n.{{ order_by or 'createdAt' }}
SKIP $skip
LIMIT $limit
"""

# -----------------------------------------------------------------------------
# COUNT - Count total entities
# -----------------------------------------------------------------------------

COUNT_{{ ENTITY_NAME_UPPER }}S = """
MATCH (n:{{ EntityName }})
RETURN count(n) as total
"""


# =============================================================================
# Relationship Queries
# =============================================================================

# -----------------------------------------------------------------------------
# LINK - Create relationship between entities
# -----------------------------------------------------------------------------

LINK_{{ ENTITY_NAME_UPPER }}_TO_{{ RELATED_ENTITY }} = """
MATCH (n:{{ EntityName }} {id: $id})
MATCH (r:{{ RelatedEntity }} {id: $related_id})
MERGE (n)-[:{{ relationship_name }}]->(r)
RETURN n, r
"""

# -----------------------------------------------------------------------------
# UNLINK - Remove relationship between entities
# -----------------------------------------------------------------------------

UNLINK_{{ ENTITY_NAME_UPPER }}_FROM_{{ RELATED_ENTITY }} = """
MATCH (n:{{ EntityName }} {id: $id})-[r:{{ relationship_name }}]->(r:{{ RelatedEntity }} {id: $related_id})
DELETE r
"""

# -----------------------------------------------------------------------------
# GET_RELATED - Get all related entities
# -----------------------------------------------------------------------------

GET_{{ ENTITY_NAME_UPPER }}_{{ RELATED_ENTITY }}S = """
MATCH (n:{{ EntityName }} {id: $id})-[r:{{ relationship_name }}]->(r:{{ RelatedEntity }})
RETURN r
"""

# -----------------------------------------------------------------------------
# GET_INCOMING - Get all entities that point to this one
# -----------------------------------------------------------------------------

GET_{{ ENTITY_NAME_UPPER }}_FROM_{{ RELATED_ENTITY }}S = """
MATCH (r:{{ RelatedEntity }})-[r:{{ relationship_name }}]->(n:{{ EntityName }} {id: $id})
RETURN r
"""


# =============================================================================
# Advanced Queries
# =============================================================================

# -----------------------------------------------------------------------------
# SEARCH - Full-text search on name/description
# -----------------------------------------------------------------------------

SEARCH_{{ ENTITY_NAME_UPPER }}S = """
MATCH (n:{{ EntityName }})
WHERE n.name CONTAINS $query OR n.description CONTAINS $query
RETURN n
ORDER BY n.name
LIMIT $limit
"""

# -----------------------------------------------------------------------------
# GET_BY_PROPERTY - Find by specific property
# -----------------------------------------------------------------------------

GET_{{ ENTITY_NAME_UPPER }}_BY_{{ PROPERTY_NAME }} = """
MATCH (n:{{ EntityName }} { {{ property_name }}: $value })
RETURN n
"""

# -----------------------------------------------------------------------------
# BATCH_CREATE - Create multiple entities
# -----------------------------------------------------------------------------

BATCH_CREATE_{{ ENTITY_NAME_UPPER }}S = """
UNWIND $entities AS entity
CREATE (n:{{ EntityName }} {
    id: entity.id,
    name: entity.name{% for prop in properties %},
    {{ prop.name }}: entity.{{ prop.name }}{% endfor %}
})
RETURN n
"""


# =============================================================================
# Schema - Add constraints and indexes (run once)
# =============================================================================

# -----------------------------------------------------------------------------
# CONSTRAINT - Unique ID constraint
# -----------------------------------------------------------------------------

# Add to SCHEMA_CONSTRAINTS list in queries.py:
# f"CREATE CONSTRAINT {{ entity_name_lower }}_id IF NOT EXISTS FOR (n:{{ EntityName }}) REQUIRE n.id IS UNIQUE"

# -----------------------------------------------------------------------------
# INDEX - Add index for frequently queried properties
# -----------------------------------------------------------------------------

# Add to SCHEMA_INDEXES list in queries.py:
# f"CREATE INDEX {{ entity_name_lower }}_name IF NOT EXISTS FOR (n:{{ EntityName }}) ON (n.name)"
# f"CREATE INDEX {{ entity_name_lower }}_created IF NOT EXISTS FOR (n:{{ EntityName }}) ON (n.createdAt)"


