# =============================================================================
# Quick Reference: Template Variables
# =============================================================================

# {{ entity_name }}      - e.g., "Deployment"
# {{ entity_name_snake }} - e.g., "deployment"  
# {{ entity_name_upper }} - e.g., "DEPLOYMENT"
# {{ related_entity }}    - e.g., "Issue", "Agent"
# {{ relationship_name }} - e.g., "RESOLVED_BY", "SPECIALIST_IN"
# {{ property_name }}     - e.g., "name", "status"
# {{ properties }}        - List of properties from entity
# {{ filters }}          - List of filter properties
# {{ order_by }}         - Property to order by
# {{ module }}           - e.g., "deployment_management"