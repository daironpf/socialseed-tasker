# Auto-detect text files and normalize line endings
* text=auto

# Explicitly mark shell scripts as LF (Unix line endings)
*.sh text eol=lf

# Explicitly mark batch and PowerShell as CRLF (Windows line endings)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files - do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.zip binary
*.tar.gz binary
