# Tasker CLI mode configuration
# =============================
# Generated by `tasker init` — edit to switch between operation modes.
#
# Resolution order (highest priority first):
#   1. Environment variable TASKER_MODE
#   2. This file (tasker.yml)
#   3. Default: "direct"

# Operation mode: "direct" (Neo4j Bolt) or "api" (REST API)
mode: direct

# --- API mode settings (only used when mode = "api") ---
api_url: http://localhost:8888
# api_key: your-api-key-here
api_timeout: 10

# --- Direct mode settings (only used when mode = "direct") ---
neo4j_uri: bolt://localhost:7687
neo4j_user: neo4j
neo4j_password: neoSocial
